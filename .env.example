# Environment Variables for MISS NEPSE Stock Analysis Platform

# API Configuration
# Set this if deploying frontend separately from backend
# Leave blank to use same-origin /api/* routes in production
VITE_API_URL=

# CORS Configuration
# Comma-separated list of allowed origins for API requests
# Example: https://miss.example.com,http://localhost:3000
# Set to '*' to allow all origins (NOT recommended for production)
CORS_ORIGIN=*

# Node Environment
NODE_ENV=development

# Port for local backend server
PORT=3001
